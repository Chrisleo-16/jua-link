# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Africa's Talking
# Leave AFRICASTALKING_USERNAME / API_KEY blank to run in mock SMS mode —
# outbound messages are logged to the console and to sms_messages instead
# of actually sent, so you can test the full flow with no account.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_USSD_SERVICE_CODE=
AFRICASTALKING_SMS_WEBHOOK_SECRET=
